[Unit]
Description=AGV Web API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/narong/agv_ws
Environment=HOME=/home/narong
Environment=AGV_WS=/home/narong/agv_ws
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/narong/agv_ws/install/setup.bash && exec ros2 run amr_tools web_api_server --host 0.0.0.0 --port 8088 --workspace /home/narong/agv_ws'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
